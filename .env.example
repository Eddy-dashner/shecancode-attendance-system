# Copy to .env (already gitignored) and fill in real values. Never commit real
# credentials to application.yaml or docker-compose.yaml.
#
# Loaded two different ways depending on how you run the app:
#  - mvnw / IDE run: spring-dotenv reads this file directly (see pom.xml),
#    so the SPRING_DATASOURCE_* and MAIL_* keys below apply.
#  - docker compose up: docker-compose reads this file itself for ${...}
#    substitution, so the POSTGRES_* keys below apply instead (they get
#    translated to SPRING_DATASOURCE_* for the app container automatically).
# Keep both sets in sync if you use both.

# Brevo (https://app.brevo.com) transactional email API key used to send
# activation/invitation emails. Sent over HTTPS instead of SMTP because
# Railway's free/trial plans block outbound SMTP ports. Settings > SMTP & API >
# API Keys.
BREVO_API_KEY=

# Must be a sender verified in Brevo (Senders & IP > Senders).
MAIL_FROM=no-reply@igirerwanda.org
MAIL_FROM_NAME=SheCanCODE

# --- mvnw / IDE runs: read by application.yaml directly ---
# URL has a dev-friendly default (localhost:5433); only needed if yours differs.
# USERNAME/PASSWORD have NO default (see application.yaml) and are required,
# so the app can't accidentally boot against a well-known default credential.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/shecancode
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# --- docker compose up: read by docker-compose.yaml for the postgres
# container AND translated into SPRING_DATASOURCE_* for the app container ---
POSTGRES_DB=shecancode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
